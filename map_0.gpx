<gpx xmlns="http://www.topografix.com/GPX/1/1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" creator="geoPHP" version="1.1" xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd"><trk><trkseg><trkpt lat="52.431474802781" lon="4.6228784745743"/><trkpt lat="52.4316383394" lon="4.6228731101563"/><trkpt lat="52.432112592162" lon="4.6233451789429"/><trkpt lat="52.432374246674" lon="4.6237957900574"/><trkpt lat="52.432514885332" lon="4.6228623813203"/><trkpt lat="52.433391413831" lon="4.6234524673035"/><trkpt lat="52.433568025672" lon="4.6234685605576"/><trkpt lat="52.433711931094" lon="4.6236241286805"/><trkpt lat="52.433926615597" lon="4.6237381310682"/><trkpt lat="52.434005108883" lon="4.6235074610929"/><trkpt lat="52.434126119091" lon="4.6231480450849"/><trkpt lat="52.43429618693" lon="4.622987112544"/><trkpt lat="52.434423737379" lon="4.6227886290769"/><trkpt lat="52.434544746438" lon="4.6228369088392"/><trkpt lat="52.434672296167" lon="4.6229441971998"/><trkpt lat="52.434793304543" lon="4.6230997653226"/><trkpt lat="52.435130163949" lon="4.6230783076505"/><trkpt lat="52.43533947335" lon="4.6230353923063"/><trkpt lat="52.435702491986" lon="4.6233948083143"/><trkpt lat="52.43590852826" lon="4.6238132329206"/><trkpt lat="52.436036074042" lon="4.6242745728712"/><trkpt lat="52.435924880304" lon="4.6250685067396"/><trkpt lat="52.435856201678" lon="4.6257229657392"/><trkpt lat="52.435872553742" lon="4.6259160847883"/><trkpt lat="52.435937961934" lon="4.6260877461652"/><trkpt lat="52.435934691527" lon="4.6261843056898"/><trkpt lat="52.435807145452" lon="4.6263881535749"/><trkpt lat="52.436032803642" lon="4.6264650177354"/><trkpt lat="52.436179971404" lon="4.626566941678"/><trkpt lat="52.436343490563" lon="4.6265132974977"/><trkpt lat="52.436523360937" lon="4.6264006447191"/><trkpt lat="52.436807639036" lon="4.6270602786169"/><trkpt lat="52.437278565865" lon="4.6276289069281"/><trkpt lat="52.437841055202" lon="4.6281868064032